{
    "name": "jeffersongoncalves/laravel-us-privacy-minors",
    "description": "Minors under the US state privacy laws: age assurance, parent or guardian links, and consent before targeted advertising or sale to known minors, at each state's age",
    "keywords": [
        "laravel",
        "privacy",
        "us-privacy",
        "minors",
        "coppa",
        "age-verification",
        "consent"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-us-privacy-minors",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "jeffersongoncalves/laravel-us-privacy": "^2.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "jeffersongoncalves/pest-plugin-database-migrations": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\UsPrivacyMinors\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\UsPrivacyMinors\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\UsPrivacyMinors\\UsPrivacyMinorsServiceProvider"
            ],
            "aliases": {
                "UsPrivacyMinors": "JeffersonGoncalves\\UsPrivacyMinors\\Facades\\UsPrivacyMinors"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
